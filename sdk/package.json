{
  "name": "wgo-sdk",
  "version": "0.1.0",
  "description": "Drop-in browser SDK for WGO (What's going on?) analytics",
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "esbuild": "^0.25.0",
    "happy-dom": "^17.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
