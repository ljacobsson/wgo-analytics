# `npm run setup` writes deploy.env for you with a guided wizard. Or copy this file to deploy.env (gitignored)
# or export these before ./scripts/deploy.sh. All optional except the region.
STACK_NAME=wgo
AWS_REGION=eu-west-1
# AWS_PROFILE=default

# Serve the dashboard, SDK and ingest on your own domain. If the domain's zone is in Route 53 (same account),
# the certificate and DNS records are created automatically. Otherwise also set CERTIFICATE_ARN (us-east-1)
# and point a CNAME at the CloudFrontDomain stack output.
# CUSTOM_DOMAIN=wgo.example.com
# HOSTED_ZONE_ID=Z0123456789ABC
# CERTIFICATE_ARN=arn:aws:acm:us-east-1:123456789012:certificate/...

# Only people with these email domains can sign up and use the dashboard (* = any subdomain).
# ALLOWED_EMAIL_DOMAINS=example.com,*.example.org

# ALLOW_SELF_SIGNUP=true

# Who can see what the install costs and manage budgets (budgets can stop every project collecting data).
# Empty: the owners of the first project created.
# ADMIN_EMAILS=you@example.com
# DELETION_PROTECTION=false

# The dashboard checks GitHub every few hours for commits on main newer than this install, and shows how to
# update. The check runs in the signed-in user's browser (a request to api.github.com); false turns it off.
# UPDATE_CHECK=true

# MCP server at https://<your domain>/mcp. Turns on Cognito MCP auth (open dynamic client registration) so
# AI assistants can register themselves; people still sign in with their WGO account.
# MCP_ENABLED=true

# Longest raw-data retention project owners can choose in Settings (default retention is 14 days). Raw data is
# what your Aurora DSQL storage bill grows with; see "Cost awareness" in the README.
# MAX_RETENTION_DAYS=90

# Optional: a project (its id from Settings) that receives hourly Aurora DSQL metrics (wgo.dsql.storage_bytes,
# wgo.dsql.dpu) and a wgo.cluster event, so you can chart your cluster and create triggers on its size.
# CLUSTER_METRICS_PROJECT_ID=

# Optional: one Slack app for "Add to Slack" in every project. Without it, a project owner sets it up from
# the Triggers page in about a minute (no redeploy). Its bot token scopes: chat:write, chat:write.public,
# channels:read, groups:read.
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
